{
  "schema_version": "0.1.0",
  "updated_at": "2026-08-17",
  "registry_id": "electroia.controller_ecosystems",
  "status": "design_foundation_private",
  "purpose": "Describe controller capabilities and electrical interface rules without coupling ElectroIA to one manufacturer.",
  "core_safety_policy": {
    "default_classification": "non_safety_control",
    "generic_arduino_or_raspberry_pi_may_execute_safety_functions": false,
    "safety_control_requires": [
      "explicit_safety_rated_controller_model",
      "verified_input_and_output_subsystem",
      "documented_safety_function",
      "risk_assessment",
      "calculation_and_validation_under_applicable_functional_safety_standard",
      "professional_approval"
    ],
    "fail_safe_state_required_for_every_critical_output": true
  },
  "signal_types": [
    {
      "id": "24VDC_PNP",
      "domain": "digital",
      "nominal_level": "24 V DC",
      "interface_rules": ["verify_source_or_sink topology", "verify common reference", "verify input thresholds and current"]
    },
    {
      "id": "24VDC_NPN",
      "domain": "digital",
      "nominal_level": "24 V DC",
      "interface_rules": ["verify source_or_sink topology", "verify common reference", "verify input thresholds and current"]
    },
    {
      "id": "RELAY_DRY_CONTACT",
      "domain": "digital",
      "nominal_level": "potential-free contact",
      "interface_rules": ["verify contact utilization category", "verify voltage and current", "protect inductive loads"]
    },
    {
      "id": "0_10V",
      "domain": "analog",
      "nominal_level": "0 to 10 V",
      "interface_rules": ["verify common reference", "use screened cable when required", "define behaviour for open circuit"]
    },
    {
      "id": "4_20mA",
      "domain": "analog",
      "nominal_level": "4 to 20 mA",
      "interface_rules": ["verify active or passive loop", "calculate loop voltage budget", "define under-range and over-range diagnostics"]
    },
    {
      "id": "RTD",
      "domain": "temperature",
      "nominal_level": "resistive sensor",
      "interface_rules": ["record sensor curve", "record 2 3 or 4 wire connection", "apply lead compensation where supported"]
    },
    {
      "id": "THERMOCOUPLE",
      "domain": "temperature",
      "nominal_level": "thermoelectric sensor",
      "interface_rules": ["record thermocouple type", "respect polarity", "provide cold junction compensation"]
    },
    {
      "id": "PULSE_ENCODER",
      "domain": "motion",
      "nominal_level": "pulse or quadrature",
      "interface_rules": ["verify electrical driver type", "verify maximum frequency", "verify screening and termination"]
    },
    {
      "id": "3V3_GPIO",
      "domain": "embedded_digital",
      "nominal_level": "3.3 V logic",
      "interface_rules": ["never connect directly to 24 V field wiring", "check absolute maximum ratings", "add isolation or industrial interface"]
    },
    {
      "id": "5V_GPIO",
      "domain": "embedded_digital",
      "nominal_level": "5 V logic",
      "interface_rules": ["never connect directly to 24 V field wiring", "check output current", "add isolation or industrial interface"]
    },
    {
      "id": "RS485",
      "domain": "communications",
      "nominal_level": "differential serial bus",
      "interface_rules": ["define protocol", "define topology", "terminate both ends", "define biasing and reference", "use galvanic isolation when required"]
    },
    {
      "id": "CAN",
      "domain": "communications",
      "nominal_level": "differential fieldbus",
      "interface_rules": ["define application protocol", "terminate both ends", "verify bitrate and cable length", "define reference and isolation"]
    },
    {
      "id": "ETHERNET",
      "domain": "communications",
      "nominal_level": "IEEE 802.3 family",
      "interface_rules": ["define physical medium and connector", "define industrial protocol", "define addressing", "define cybersecurity zone and access policy"]
    }
  ],
