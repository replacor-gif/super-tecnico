{
  "openapi": "3.1.0",
  "info": {
    "title": "ElectroIA Discovery API",
    "version": "0.3.0",
    "description": "Public read-only discovery, reviewed-symbol search, document profiles and execution-safety policy for ElectroIA. Diagram execution remains private and is not exposed by this HTTP description."
  },
  "servers": [
    { "url": "https://app.replacor.com/super-tecnico" }
  ],
  "paths": {
    "/api/index.php?action=electroia-public-status": {
      "get": {
        "operationId": "getElectroIAPublicStatus",
        "summary": "Get the safe public release and capability summary",
        "responses": {
          "200": {
            "description": "Curated status without private route or credentials",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/api/index.php?action=electroia-symbol-search": {
      "get": {
        "operationId": "searchElectroIAReviewedSymbols",
        "summary": "Search the reviewed public symbol catalog",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 2, "maxLength": 80 } },
          { "name": "category", "in": "query", "required": false, "schema": { "type": "string", "maxLength": 80 } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 12, "default": 8 } }
        ],
        "responses": {
          "200": {
            "description": "Ranked summaries of reviewed public symbols",
            "content": { "application/json": { "schema": { "type": "object" } } }
          },
          "422": { "description": "Invalid search query" },
          "429": { "description": "Rate limit exceeded" }
        }
      }
    },
    "/data/electroia/discovery.json": {
      "get": {
        "operationId": "getElectroIADiscovery",
        "summary": "Get machine-readable ElectroIA discovery metadata",
        "responses": {
          "200": {
            "description": "Discovery document",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/data/electroia/tool-manifest.json": {
      "get": {
        "operationId": "getElectroIAToolManifest",
        "summary": "Get tools, responsibilities and input schemas",
        "responses": {
          "200": {
            "description": "Tool manifest",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/data/electroia/diagram-document.schema.json": {
      "get": {
        "operationId": "getElectroIADiagramSchema",
        "summary": "Get the neutral structured-diagram JSON Schema",
        "responses": {
          "200": {
            "description": "JSON Schema",
            "content": { "application/schema+json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/data/electroia/document-profiles.json": {
      "get": {
        "operationId": "getElectroIADocumentProfiles",
        "summary": "Get the experimental graphical and document-profile separation",
        "responses": {
          "200": {
            "description": "Machine-readable experimental profiles without a conformity claim",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/data/electroia/public-execution-policy.json": {
      "get": {
        "operationId": "getElectroIAExecutionPolicy",
        "summary": "Get limits and safeguards planned for remote execution",
        "responses": {
          "200": {
            "description": "Disabled-by-default public execution policy",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    },
    "/data/electroia/symbol-library.json": {
      "get": {
        "operationId": "getElectroIASymbolLibrary",
        "summary": "Get normalized symbol definitions and quality status",
        "responses": {
          "200": {
            "description": "Normalized symbol library",
            "content": { "application/json": { "schema": { "type": "object" } } }
          }
        }
      }
    }
  }
}
