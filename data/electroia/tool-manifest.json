{
  "schema_version": "1.5",
  "name": "electroia-tools",
  "title": "ElectroIA — motor gráfico electrotécnico neutral",
  "description": "Herramientas deterministas para validar, dibujar y documentar proyectos electrotécnicos definidos por una IA o aplicación externa.",
  "provider_neutral": true,
  "embedded_ai_model": false,
  "billing_required_by_electroia": false,
  "diagram_engine_version": "1.17.0-alpha.1",
  "diagram_contract_version": "1.0",
  "design_model_version": "1.0",
  "core_policy": {
    "calculates_values": false,
    "selects_components": false,
    "renders_only": false,
    "compiles_ai_friendly_specifications": true,
    "generates_technical_documentation": true,
    "invents_missing_engineering_values": false
  },
  "shared_catalogs": {
    "connectors": "../connectors/tool-manifest.json",
    "connector_usage": "La IA llamante puede resolver connector_id y contact.id antes de construir el documento. ElectroIA conserva esos identificadores como trazabilidad, pero no inventa pinouts.",
    "embedded_platforms": "../embedded-platforms/tool-manifest.json",
    "embedded_platform_usage": "La IA llamante puede buscar o preseleccionar una plataforma y después representar sus interfaces mediante símbolos y conectores normalizados."
  },
  "responsibilities": {
    "diagram_engine": [
      "validate_document",
      "resolve_normalized_symbols",
      "place_on_common_grid",
      "route_orthogonal_connections",
      "render_single_canvas_svg",
      "generate_bom_wires_terminals_io_and_cross_references",
      "report_diagnostics"
    ],
    "calling_ai": [
      "understand_user_intent",
      "choose_topology",
      "calculate_values",
      "select_components",
      "provide_symbols_terminals_and_nets"
    ]
  },
  "capabilities": {
    "standard_profiles": ["IEC_EXPERIMENTAL"],
    "document_profile_registry": "document-profiles.json",
    "ai_design_bridge": "ai-bridge.json",
    "diagram_spec_schema": "diagram-spec.schema.json",
    "technical_package_schema_version": "1.0",
    "execution_policy": "public-execution-policy.json",
    "document_kinds": ["circuit_diagram", "single_line_diagram", "multi_line_diagram"],
    "grid_pitch_mil": 50,
    "single_canvas_default": true,
    "hard_limits": {
      "request_body_bytes": 262144,
      "components_per_document": 200,
      "nets_per_document": 400,
      "connections_per_net": 100,
      "total_connections": 2000
    },
    "normalized_symbol_count": 501,
    "catalog_symbol_count": 501,
    "engine_symbol_count": 504,
    "reviewed_catalog_symbol_count": 501,
    "auto_draft_catalog_symbol_count": 0,
    "internal_template_count": 3,
    "symbol_quality_policy": "Todo el catálogo público tiene geometría y terminales revisados. Los bloques con terminales agrupados exigen fabricante, modelo y documentación exacta antes de convertirlos en cableado físico.",
    "reviewed_families": ["connections_and_references", "passive_components", "discrete_semiconductors", "optoelectronics_and_isolation", "electrical_protections", "relays_switches_and_actuators", "machines_and_actuators", "functional_integrated_circuits", "digital_electronics", "power_and_hvac", "sensors_and_transducers", "measurement_and_indication", "connectors_and_communications", "sources_and_power", "installations_and_signalling", "special_devices", "programmable_automation_and_control", "drives_and_motor_control", "building_services_control"],
    "reviewed_batches": ["hvac_sensors_temperature_pressure_airflow_level_air_quality_leak_frost_current", "passive_components_2026_08", "discrete_semiconductors_2026_08", "opto_isolation_2026_08", "functional_ics_2026_08", "digital_electronics_2026_08", "power_hvac_2026_08", "sensors_complete_2026_08", "measurement_complete_2026_08", "connectors_complete_2026_08", "catalog_completion_2026_08", "professional_automation_drives_building_2026_08"],
    "internal_batches": ["generic_rendering_helpers"],
    "current_legacy_topologies": [
      "low_side_relay_driver",
      "isolated_low_side_relay_driver",
      "thermostatic_dc_fan_controller",
      "direct_on_line_motor_starter",
      "residential_distribution_single_line"
    ],
    "inputs": [
      "structured_diagram_json",
      "spanish_text_through_legacy_adapters",
      "image_analysis_from_external_ai",
      "hand_drawn_sketch_analysis_from_external_ai",
      "connector_ids_and_contact_ids",
      "embedded_platform_ids"
    ],
    "raw_inputs_not_yet_supported": ["raw_photo", "raw_hand_drawn_sketch"],
    "image_contract": "La IA que ve la imagen extrae símbolos, terminales y redes; ElectroIA valida y dibuja el documento estructurado."
  },
  "discovery": {
    "status": "public_discovery_private_execution",
    "llms_path": "llms.txt",
    "machine_manifest_path": "data/electroia/discovery.json",
    "openapi_path": "data/electroia/discovery.openapi.json",
    "mcp_server_metadata_path": "electroia-tool-server/server.json",
    "remote_mcp_available": false,
    "local_mcp_available": true,
    "public_status_endpoint": "api/index.php?action=electroia-public-status",
    "public_symbol_search_endpoint": "api/index.php?action=electroia-symbol-search&q={query}",
    "public_showcase_path": "electroia.html",
    "public_gallery_path": "data/electroia/public-gallery.json",
    "release_readiness_path": "data/electroia/public-release-readiness.json"
  },
  "tools": [
    {
      "name": "electroia_get_capabilities",
      "description": "Devuelve las capacidades, responsabilidades y límites de esta versión.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "electroia_get_diagram_contract",
      "description": "Devuelve el contrato neutral, la rejilla y las definiciones de símbolos ya normalizadas.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      }
    },
    {
      "name": "electroia_prepare_design_brief",
      "description": "Prepara un encargo neutral para que una IA interna o externa diseñe y calcule antes de entregar el documento a ElectroIA.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request"],
        "properties": {
          "request": { "type": "string", "minLength": 8, "maxLength": 2000 },
          "language": { "type": "string", "minLength": 2, "maxLength": 5, "default": "es" },
          "document_kind": { "type": "string", "enum": ["circuit_diagram", "single_line_diagram", "multi_line_diagram"] }
        }
      }
    },
    {
      "name": "electroia_search_symbols",
      "description": "Busca y ordena símbolos normalizados por términos técnicos, alias, nombre, tipo o categoría; devuelve coincidencia, terminales y estado de revisión.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["query"],
        "properties": {
          "query": { "type": "string", "minLength": 1, "maxLength": 100 },
          "category": { "type": "string", "minLength": 1, "maxLength": 100 },
          "review_status": { "type": "string", "enum": ["engine_reviewed", "auto_draft", "engine_internal"] },
          "limit": { "type": "integer", "minimum": 1, "maximum": 50, "default": 12 }
        }
      }
    },
    {
      "name": "electroia_get_symbol",
      "description": "Devuelve la definición exacta, dimensiones y terminales de un símbolo normalizado.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol_id"],
        "properties": {
          "symbol_id": { "type": "string", "minLength": 3, "maxLength": 64 }
        }
      }
    },
    {
      "name": "electroia_compile_diagram",
      "description": "Compila una especificación amigable para IAs: resuelve símbolos y terminales, asigna referencias, coloca, valida, enruta y devuelve documento neutral, SVG y dossier técnico.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["spec"],
        "properties": {
          "spec": { "$ref": "diagram-spec.schema.json" }
        }
      }
    },
    {
      "name": "electroia_render_diagram",
      "description": "Valida símbolos, terminales y redes y devuelve un plano SVG junto con su dossier técnico. No calcula ni selecciona componentes.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document"],
        "properties": {
          "document": {
            "$ref": "diagram-document.schema.json"
          }
        }
      }
    },
    {
      "name": "electroia_generate_technical_package",
      "description": "Genera BOM, numeración de conductores, bornes, cables, E/S, referencias cruzadas y control documental sin inventar valores técnicos ausentes.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document"],
        "properties": {
          "document": {
            "$ref": "diagram-document.schema.json"
          }
        }
      }
    },
    {
      "name": "electroia_analyze_request",
      "description": "Adaptador temporal que distingue los Casos 001 y 002 y devuelve las preguntas pendientes.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request"],
        "properties": {
          "request": {
            "type": "string",
            "minLength": 8,
            "maxLength": 500
          }
        }
      }
    },
    {
      "name": "electroia_generate_relay_driver",
      "description": "Adaptador temporal que genera un controlador de relé DC para demostrar el motor gráfico.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relay_voltage", "signal_voltage", "controller", "coil_type", "load_kind", "isolation"],
        "properties": {
          "request": { "type": "string", "maxLength": 500 },
          "relay_voltage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
          "signal_voltage": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
          "controller": { "type": "string", "enum": ["arduino", "micro_3v3", "sensor", "unknown"] },
          "coil_type": { "type": "string", "enum": ["dc", "ac", "unknown"] },
          "coil_current_ma": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 5000 },
          "load_kind": { "type": "string", "minLength": 2, "maxLength": 180 },
          "load_current_a": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000 },
          "isolation": { "type": "boolean" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["text", "image_analysis", "hand_drawn_sketch_analysis"] },
              "note": { "type": "string", "maxLength": 500 }
            }
          }
        }
      }
    },
    {
      "name": "electroia_generate_temperature_fan",
      "description": "Adaptador temporal que genera un controlador de ventilador DC para demostrar el motor gráfico.",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fan_voltage", "turn_on_temperature_c", "hysteresis_c", "fan_type"],
        "properties": {
          "request": { "type": "string", "maxLength": 500 },
          "fan_voltage": { "type": "number", "minimum": 3, "maximum": 30 },
          "fan_current_a": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 20 },
          "turn_on_temperature_c": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 },
          "hysteresis_c": { "type": "number", "minimum": 1, "maximum": 20 },
          "fan_type": { "type": "string", "enum": ["dc_2wire", "unknown"] },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": { "type": "string", "enum": ["text", "image_analysis", "hand_drawn_sketch_analysis"] },
              "note": { "type": "string", "maxLength": 500 }
            }
          }
        }
      }
    }
  ]
}
